              alt="Sucursal Casa Central"
              class="img-fluid branch-image"
            >
          </div>
          <div class="branch-body">
            <h3 class="branch-name">
              Casa Central
            </h3>
            <p class="branch-address">
              <i class="bi bi-map-fill"></i>
              Av. Luro 7146 – Mar del Plata
            </p>
            <p class="branch-contact">
              <span><i class="bi bi-telephone-fill"></i> Tel: (223) 499-1600</span>
              <span>
                <i class="bi bi-whatsapp"></i>
                WhatsApp:
                <a href="https://wa.me/5492235940094" target="_blank">
                  223 594 0094
                </a>
              </span>
            </p>
            <p class="branch-hours">
              <i class="bi bi-clock"></i>
              Lunes a viernes de 8:00 a 17:00 hs. Sábados de 8:00 a 13:00 hs.
            </p>
          </div>
        </article>
      </div>

