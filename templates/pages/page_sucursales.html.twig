</section>

<style>
  #maincontent {
    padding-bottom: 0 !important;
  }

  .branches-section {
    padding: 40px 0 60px;
    background: #f7f7f9;
  }

  .branches-title {
    font-family: 'Oswald', sans-serif;
    font-size: 32px;
    font-weight: 600;
    color: #252525;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 5px;
  }

  .branches-subtitle {
    color: #6c757d;
    font-size: 15px;
    margin-bottom: 25px;
  }

  .branch-card {
    background: #ffffff;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .branch-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 35px rgba(0, 0, 0, 0.08);
  }

  .branch-image-wrapper {
    position: relative;
    overflow: hidden;
  }

  .branch-image {
    width: 100%;
    height: 230px;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .branch-card:hover .branch-image {
    transform: scale(1.05);
  }

  .branch-body {
    padding: 18px 20px 20px;
  }

  .branch-name {
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 6px;
    color: #212529;
  }

  .branch-address,
  .branch-hours {
    margin-bottom: 6px;
    color: #555;
    font-size: 14px;
  }

  .branch-contact {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 6px;
    color: #555;
    font-size: 14px;
  }

  .branch-contact span {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .branch-hours i,
  .branch-contact i,
  .branch-address i {
    color: #007bff;
    margin-right: 4px;
  }

  .branch-contact a {
    color: #25d366;
    font-weight: 600;
    text-decoration: none;
  }

  .branch-contact a:hover {
    text-decoration: underline;
  }

  @media (max-width: 767.98px) {
    .branches-section {
      padding: 25px 0 40px;
    }
    .branch-image {
      height: 200px;
    }
    .branch-body {
      padding: 14px 15px 16px;
    }
  }
</style>
{% endblock %}