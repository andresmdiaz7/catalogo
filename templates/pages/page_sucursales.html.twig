{% extends 'base.html.twig' %}

{% block title %}Ciardi Hnos - Sucursales{% endblock %}

{% block body %}
<section class="branches-section">
  <div class="container">
    <div class="row justify-content-center mb-4">
      <div class="col-12 text-center">
        <h1 class="branches-title">Nuestras sucursales</h1>
        <p class="branches-subtitle">
          Encontranos en diferentes puntos estratégicos de la ciudad y la zona.
        </p>
      </div>
    </div>

    <div class="row g-4">

      {# SUCURSAL 1 #}
      <div class="col-lg-6 col-md-6">
