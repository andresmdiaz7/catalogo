{% extends 'base.html.twig' %}

{% block title %}Mi Perfil{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="row">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h1 class="h4 mb-0">
                        <i class="bi bi-person-circle me-2"></i>Mi Perfil
                    </h1>
                </div>
                <div class="card-body">
                    {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                                {{ message }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        {% endfor %}
                    {% endfor %}

                    {{ form_start(form) }}
                    
                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="mb-3 text-primary">
                                <i class="bi bi-pencil-square me-2"></i>Información Editable
                            </h5>
                            
                            {{ form_row(form.direccion) }}
                            {{ form_row(form.telefono) }}
                            {{ form_row(form.email) }}
                            {{ form_row(form.web) }}
                            {{ form_row(form.rentabilidad) }}
                            
                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-save me-2"></i>Guardar Cambios
                                </button>
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <h5 class="mb-3 text-info">
                                <i class="bi bi-info-circle me-2"></i>Información de la Cuenta
                            </h5>
                            
                            <div class="mb-3">
                                <label class="form-label fw-bold">Código:</label>
                                <p class="form-control-plaintext">{{ cliente.codigo }}</p>
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label fw-bold">Razón Social:</label>
                                <p class="form-control-plaintext">{{ cliente.razonSocial }}</p>
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label fw-bold">CUIT:</label>
                                <p class="form-control-plaintext">{{ cliente.cuit }}</p>
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label fw-bold">Categoría Impositiva:</label>
                                <p class="form-control-plaintext">{{ cliente.categoriaImpositiva.nombre }}</p>
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label fw-bold">Tipo de Cliente:</label>
                                <p class="form-control-plaintext">
                                    {{ cliente.tipoCliente.nombre }}
                                    {% if cliente.tipoCliente.nombre == 'Mayorista' %}
                                        <span class="badge bg-info ms-2">Lista de precios 400</span>
                                    {% endif %}
                                </p>
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label fw-bold">Localidad:</label>
                                <p class="form-control-plaintext">{{ cliente.localidad.provincia.nombre }} - {{ cliente.localidad.nombre }}</p>
                            </div>
                            
                            {% if cliente.vendedor %}
                            <div class="mb-3">
                                <label class="form-label fw-bold">Vendedor Asignado:</label>
                                <p class="form-control-plaintext">
                                    <i class="bi bi-person-badge me-1"></i>{{ cliente.vendedor.nombre }}
                                </p>
                            </div>
                            {% endif %}
                            
                            {% if cliente.responsableLogistica %}
                            <div class="mb-3">
                                <label class="form-label fw-bold">Responsable de Logística:</label>
                                <p class="form-control-plaintext">
                                    <i class="bi bi-truck me-1"></i>{{ cliente.responsableLogistica.nombre }} {{ cliente.responsableLogistica.apellido }}
                                </p>
                            </div>
                            {% endif %}
                            
                            {% if cliente.categoria %}
                            <div class="mb-3">
                                <label class="form-label fw-bold">Categoría:</label>
                                <p class="form-control-plaintext">{{ cliente.categoria.nombre }}</p>
                            </div>
                            {% endif %}
                        </div>
                    </div>
                    
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-gear me-2"></i>Configuración de Cuenta
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Estado en la Web:</label>
                        <p class="form-control-plaintext">
                            {% if cliente.habilitado %}
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle me-1"></i>Habilitado
                                </span>
                            {% else %}
                                <span class="badge bg-danger">
                                    <i class="bi bi-x-circle me-1"></i>Deshabilitado
                                </span>
                            {% endif %}
                        </p>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Cuenta Corriente:</label>
                        <p class="form-control-plaintext">
                            {% if cliente.habilitadoCuentaCorriente %}
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle me-1"></i>Habilitada
                                </span>
                            {% else %}
                                <span class="badge bg-secondary">
                                    <i class="bi bi-x-circle me-1"></i>No Habilitada
                                </span>
                            {% endif %}
                        </p>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Cantidad de Ingresos:</label>
                        <p class="form-control-plaintext">
                            <span class="badge bg-primary">{{ cliente.cantidadIngresos }}</span>
                        </p>
                    </div>
                    
                    {% if cliente.ultimaVisita %}
                    <div class="mb-3">
                        <label class="form-label fw-bold">Última Visita:</label>
                        <p class="form-control-plaintext">
                            <small>{{ cliente.ultimaVisita|date('d/m/Y H:i') }}</small>
                        </p>
                    </div>
                    {% endif %}
                    
                    {% if cliente.observaciones %}
                    <div class="mb-3">
                        <label class="form-label fw-bold">Observaciones:</label>
                        <div class="alert alert-info">
                            <small>{{ cliente.observaciones }}</small>
                        </div>
                    </div>
                    {% endif %}
                </div>
            </div>
            
            <div class="mt-3">
                <a href="{{ path('app_cliente_panel') }}" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Volver al Panel
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %} 