{% extends 'admin/base.html.twig' %}

{% block title %}Clientes asociados al usuario {{ usuario.email }}{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Clientes asociados</h1>
            <p class="text-muted">Usuario: <strong>{{ usuario.email }}</strong> - {{ usuario.nombreReferencia }}</p>
        </div>
        <a href="{{ path('app_admin_usuario_index') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Volver a usuarios
        </a>
    </div>

    {% if clientes|length > 0 %}
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i>
            <strong>Importante:</strong> Para eliminar este usuario, primero debe eliminar o reasignar estos {{ clientes|length }} cliente(s) a otro usuario.
        </div>

        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Razón Social</th>
                                <th>Email</th>
                                <th>Tipo</th>
                                <th>Habilitado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for cliente in clientes %}
                            <tr>
                                <td>{{ cliente.codigo }}</td>
                                <td>{{ cliente.razonSocial }}</td>
                                <td>{{ cliente.email }}</td>
                                <td>{{ cliente.tipoCliente.nombre }}</td>
                                <td>
                                    {% if cliente.habilitado %}
                                        <span class="badge bg-success">Habilitado</span>
                                    {% else %}
                                        <span class="badge bg-danger">Deshabilitado</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="{{ path('app_admin_cliente_editar', {'id': cliente.id}) }}" 
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil"></i> Editar
                                        </a>
                                        <form method="post" action="{{ path('app_admin_cliente_eliminar', {'id': cliente.id}) }}" 
                                              onsubmit="return confirm('¿Está seguro que desea eliminar este cliente?');" 
                                              style="display: inline;">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ cliente.id) }}">
                                            <button class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i> Eliminar
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% else %}
        <div class="alert alert-success">
            <i class="bi bi-check-circle"></i>
            Este usuario no tiene clientes asociados y puede ser eliminado sin problemas.
        </div>
    {% endif %}
{% endblock %} 