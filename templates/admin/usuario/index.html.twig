{% extends 'admin/base.html.twig' %}

{% block title %}Gestión de Usuarios{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Usuarios</h1>
        <a href="{{ path('app_admin_usuario_nuevo') }}" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo Usuario
        </a>
    </div>


    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Email</th>
                            <th>Nombre Referencia</th>
                            <th>Tipo de Usuario</th>
                            <th>Clientes Asociados</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for usuario in usuarios %}
                        <tr>
                            <td>{{ usuario.email }}</td>
                            <td>{{ usuario.nombreReferencia }}</td>
                            <td>{{ usuario.tipoUsuario ? usuario.tipoUsuario.nombre : '-' }}</td>
                            <td>
                                {% if usuario.hasClientes %}
                                    <span class="badge bg-info">{{ usuario.clientes|length }} cliente(s)</span>
                                    {% if usuario.clientes|length > 0 %}
                                        <br><small class="text-muted">
                                            {% for cliente in usuario.clientes|slice(0, 2) %}
                                                {{ cliente.razonSocial }}{% if not loop.last %}, {% endif %}
                                            {% endfor %}
                                            {% if usuario.clientes|length > 2 %}
                                                <br>y {{ usuario.clientes|length - 2 }} más...
                                            {% endif %}
                                        </small>
                                        <br><a href="{{ path('app_admin_usuario_clientes', {'id': usuario.id}) }}" class="btn btn-xs btn-outline-info mt-1">
                                            <i class="bi bi-people"></i> Ver todos
                                        </a>
                                    {% endif %}
                                {% else %}
                                    <span class="text-muted">Sin clientes</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a href="{{ path('app_admin_usuario_editar', {'id': usuario.id}) }}" 
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i> Editar
                                    </a>
                                    <form method="post" action="{{ path('app_admin_usuario_eliminar', {'id': usuario.id}) }}" 
                                          onsubmit="return confirm('{% if usuario.hasClientes %}Este usuario tiene {{ usuario.clientes|length }} cliente(s) asociado(s). No podrá eliminarse hasta que reasigne o elimine estos clientes. {% endif %}¿Está seguro que desea eliminar este usuario?');" 
                                          style="display: inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ usuario.id) }}">
                                        <button class="btn btn-sm btn-outline-danger" {% if usuario.hasClientes %}title="No se puede eliminar: tiene clientes asociados"{% endif %}>
                                            <i class="bi bi-trash"></i> Eliminar
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5">No hay usuarios registrados</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %} 