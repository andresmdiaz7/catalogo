<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('css/personalizacion.css') }}">
        {% endblock %}
    </head>
    <body>
        {% include 'partials/_mensajes_flash.html.twig' %}

        <div class="container-fluid fegime">
            <div class="end-0 me-3 pt-1">
                <img src="/images/fegime-logo.png">
            </div>
        </div>

        {# Menú responsivo de páginas estáticas #}
        <nav class="navbar navbar-expand-lg navbar-light bg-white py-0 border-bottom border-light shadow-sm" style="background-color: #ffffff !important;">
            <div class="container-fluid">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPaginasEstaticas" aria-controls="menuPaginasEstaticas" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                    <span class="ms-2 d-inline-block text-dark">Menú</span>
                </button>
                <div class="collapse navbar-collapse" id="menuPaginasEstaticas">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                        
                        {# Ejemplo de menú con dropdown #}
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" 
                               href="#" 
                               id="dropdownHogar" 
                               role="button" 
                               data-bs-toggle="dropdown" 
                               aria-expanded="false">
                                Empresa
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="dropdownHogar">
                                <li>
                                    <a class="dropdown-item" href="{{ path('app_pagina_sucursales') }}">
                                        Sucursales
                                    </a>
                                </li>
                                <li><a class="dropdown-item" href="#">Nosotros</a></li>
                                <li><a class="dropdown-item" href="#">RRHH</a></li>
                                <li><a class="dropdown-item" href="#">Trayectoria</a></li>
                                <li><a class="dropdown-item" href="#">Nuestros Valores</a></li>
                                <li>
                                    <a class="dropdown-item" href="{{ path('app_pagina_sustentabilidad') }}">
                                        Sustentabilidad
                                    </a>
                                </li>
                                <li><a class="dropdown-item" href="#">R.S.E.</a></li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" href="{{ path('app_pagina_fegime') }}">
                                Fegime
                            </a>
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="{{ path('app_pagina_academy') }}">
                                Academy
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" href="#">
                                Solicitar Presupuesto
                            </a>
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="#">
                                Contacto
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        {# Header de la página #}
        <div class="container-fluid px-0">
            <div class="row align-items-center py-2 py-lg-3 px-2 px-lg-3">
                <!-- Logo - Columna izquierda -->
                <div class="col-12 col-lg-3 text-center text-lg-start mb-3 my-lg-3">
                    <a class="navbar-brand" href="/">
                        <img src="/images/logo.jpg" alt="Ciardi Hnos" class="logo">
                    </a>
                </div>
                
                <!-- Buscador - Columna central -->
                <div class="col-12 col-lg-5 mb-3 mb-lg-0 pe-lg-4">
                    <form class="d-flex" action="{{ path('app_catalogo_index') }}" method="GET">
                        <div class="input-group">
                            <input type="text" 
                                   name="buscar" 
                                   class="form-control" 
                                   placeholder="Buscar artículo" 
                                   value="{{ app.request.query.get('buscar') }}"
                                   aria-label="Buscar artículo" 
                                   aria-describedby="button-addon2">
                            <button class="btn btn-secondary" type="submit" id="button-addon2">Buscar</button>
                        </div>
                    </form>
                    <div class="d-flex gap-2 justify-content-center align-items-center mt-3 mt-lg-4">

                        <!-- Botón "Tienda" -->
                        <a href="https://www.ciardi.com.ar" class="btn  fw-semibold" style="font-weight: 700; letter-spacing: 0.03em; font-size: 1.05rem;  background: #fff; color: #232323; padding: 0.5rem 1.15rem;">
                            Tienda
                        </a>

                        <!-- Botón "Ciardi Lighting" -->
                        <a href="/lighting" target="_blank" class=" btn fw-semibold" style="font-weight: 600; letter-spacing: 0.03em; font-size: 1.05rem; padding: 0.5rem 1.15rem;">
                            </i>Ciardi Lighting
                        </a>
                        
                    </div>
                </div>

               
                
                <!-- Botones de usuario - Columna derecha -->
                <div class="col-12 col-lg-4 text-center text-lg-end">
                    <div class="btn-group" role="group" aria-label="User actions">

                        {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                            
                            {% if is_granted('ROLE_ADMIN') %} {% include 'partials/_menu_admin.html.twig' %} {% endif %}

                            {% if is_granted('ROLE_VENDEDOR') %} {% include 'partials/_menu_vendedor.html.twig' %} {% endif %}

                            {% if is_granted('ROLE_CLIENTE') %} {% include 'partials/_menu_cliente.html.twig' %} {% endif %}
                            
                        {% else %}
                            <a class="btn btn-ciardi" href="{{ path('app_login') }}"><i class="bi bi-box-arrow-in-right pe-2"></i>Iniciar Sesión</a>
                        {% endif %}
                    </div>
                </div>
                
            </div>
        </div>

        {# Menu de secciones #}
        <nav class="navbar navbar-expand-lg navbar p-0 bg-body-secondary">
            <div class="container-fluid">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    {% set seccionActiva = app.request.attributes.get('id') %}
                    <ul class="navbar-nav me-auto">
                        {% for item in secciones_global %}
                            <li class="nav-item">
                                <a 
                                    class="nav-link {% if seccionActiva == item.seccion.id %}active{% endif %}"
                                    href="{{ path('app_catalogo_seccion', {id: item.seccion.id}) }}">
                                    
                                    {{ item.seccion.nombre }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </nav>
        
        {% block sliders %}{% endblock %}
        
        {% block body %}{% endblock %}
        
        <footer class="bg-dark text-white pt-5 mt-5">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-12 text-center mb-4">
                        <h2 class="h3">Nuestras Sucursales</h2>
                        <p class="text-white">Estamos cerca tuyo para brindarte el mejor servicio</p>
                    </div>
                </div>
                <div class="row g-4">
                    <!-- Casa Central -->
                    <div class="col">
                        <div class="text-center">
                            <i class="bi bi-building fs-2 text-ciardi mb-3"></i>
                            <h3 class="h5">Casa Central</h3>
                            <p class="mb-1 small">Av. Luro 7146 - Mar del Plata</p>
                            <p class="mb-1 small"><i class="bi bi-telephone-fill me-2"></i>(223) 499-1600</p>
                            <p class="mb-1 small"><i class="bi bi-whatsapp me-2"></i></i>(223) 223594 0094</p>
                            <p class="mb-0 small"><i class="bi bi-envelope-fill me-2"></i>contacto@ciardi.com.ar</p>
                            <p class="mb-0 small"><i class="bi bi-clock me-2"></i>Lunes a viernes de 8:00 hs a 17:00 hs.</br> Sábados de 8:00 hs a 13:00 hs.</p>
                        </div>
                    </div>

                    <!-- Sucursal Belgrano -->
                    <div class="col">
                        <div class="text-center">
                            <i class="bi bi-shop fs-2 text-ciardi mb-3"></i>
                            <h3 class="h5">Centro</h3>
                            <p class="mb-1 small">Belgrano 3547 - Mar del Plata</p>
                            <p class="mb-1 small"><i class="bi bi-telephone-fill me-2"></i>(223) 499-1670</p>
                            <p class="mb-1 small"><i class="bi bi-whatsapp me-2"></i></i>(223) 223524 7095</p>
                            <p class="mb-0 small"><i class="bi bi-envelope-fill me-2"></i>sucursalcentro@ciardi.com.ar</p>
                            <p class="mb-0 small"><i class="bi bi-clock me-2"></i>Lunes a viernes de 8:00 hs a 17:00 hs.</br> Sábados de 8:00 hs a 13:00 hs.</p>
                        </div>
                    </div>

                    <!-- Sucursal Puerto -->
                    <div class="col">
                        <div class="text-center">
                            <i class="bi bi-shop fs-2 text-ciardi mb-3"></i>
                            <h3 class="h5">Puerto</h3>
                            <p class="mb-1 small">Edison 701 - Mar del Plata</p>
                            <p class="mb-1 small"><i class="bi bi-telephone-fill me-2"></i>(223) 499-1680</p>
                            <p class="mb-1 small"><i class="bi bi-whatsapp me-2"></i></i>(223) 223302 6092</p>
                            <p class="mb-0 small"><i class="bi bi-envelope-fill me-2"></i>sucursalpuerto@ciardi.com.ar</p>
                            <p class="mb-0 small"><i class="bi bi-clock me-2"></i>Lunes a viernes de 8:00 hs a 17:00 hs.</br> Sábados de 8:00 hs a 13:00 hs.</p>
                        </div>
                    </div>

                    <!-- Sucursal Balcarce -->
                    <div class="col">
                        <div class="text-center">
                            <i class="bi bi-shop fs-2 text-ciardi mb-3"></i>
                            <h3 class="h5">Balcarce</h3>
                            <p class="mb-1 small">Av. Favaloro 850 esq. 26 - Balcarce</p>
                            <p class="mb-1 small"><i class="bi bi-telephone-fill me-2"></i>(223) 464-1666</p>
                            <p class="mb-1 small"><i class="bi bi-whatsapp me-2"></i></i>(223) 2266 47 0734</p>
                            <p class="mb-0 small"><i class="bi bi-envelope-fill me-2"></i>sucursalbalcarce@ciardi.com.ar</p>
                            <p class="mb-0 small"><i class="bi bi-clock me-2"></i>Lunes a viernes de 8:00 a 13:00 hs y de 15:00 a 19:00 hs.</br> Sábados de 8:00 hs a 13:00 hs.</p>
                        </div>
                    </div>


                    <!-- Sucursal La Costa -->
                    <div class="col">
                        <div class="text-center">
                            <i class="bi bi-shop fs-2 text-ciardi mb-3"></i>
                            <h3 class="h5">La Costa</h3>
                            <p class="mb-1 small">RN11 Km 398.5 - Gral. Madariaga</p>
                            <p class="mb-1 small"><i class="bi bi-whatsapp me-2"></i></i>(223) 225453 4772</p>
                            <p class="mb-0 small"><i class="bi bi-envelope-fill me-2"></i>sucursalcosta@ciardi.com.ar</p>
                            <!--<p class="mb-0 small"><i class="bi bi-clock me-2"></i>Lunes a viernes de 8:00 a 13:00 hs y de 15:00 a 19:00 hs. Sábados de 8:00 hs a 13:00 hs.</p>-->
                        </div>
                    </div>
                </div>
            </div>
            <div class="container-fluid">
                <div class="row">
                    <div class="col-12 text-center bg-dark text-white py-4 border-top border-secondary mt-5">
                        <div class="fw-light"><span class="fw-semibold me-3">1979-2025</span>  Todos los derechos reservados Ciardi Hnos.</div>
                        <div class="fw-light">Diseño y desarrollo por <a href="https://www.linkedin.com/in/manuel-andres-diaz/" target="_blank" class="text-white-50 mx-3"><i class="bi bi-linkedin me-1"></i>Andres Diaz</a></div>
                    </div>
                </div>
            </div>
        </footer>
        
        {# En base.html.twig, antes del cierre del body #}
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/lang/summernote-es-ES.min.js"></script>
        
        {% block javascripts %}
            <script src="{{ asset('js/generales.js') }}"></script>
        {% endblock %}
    </body>
</html>
